{
  "manifest_version": 3,
  "name": "Bijoy Bayanno Input Tool",
  "version": "1.0.0",
  "description": "Type in Bengali on any webpage using the Bijoy Bayanno keyboard layout",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Bijoy Bayanno Input Tool"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "bijoy-layout.js",
        "content/ime-engine.js",
        "content/visual-indicator.js",
        "content/content.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "toggle-ime": {
      "suggested_key": {
        "default": "Ctrl+Shift+B",
        "mac": "Command+Shift+B"
      },
      "description": "Toggle Bijoy IME on/off"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
